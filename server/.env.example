# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (To be configured in upcoming milestones)
MONGODB_URI=mongodb://localhost:27017/staynest

# Authentication Secrets (To be configured in upcoming milestones)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Cloudinary (To be configured in upcoming milestones)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / Nodemailer (To be configured in upcoming milestones)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@staynest.com
